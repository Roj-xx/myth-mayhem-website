---
import Base from '../layouts/Base.astro';
import cards from '../data/cards.json';

const TYPES = [
  ['creature', 'Creatures'], ['ritual', 'Rituals'], ['domain', 'Domains'], ['building', 'Buildings'], ['god', 'Gods'],
] as const;
const RARITY: Record<string, string> = { '★3': 'Common', '★4': 'Rare', '★5': 'Legendary', '✦': 'Divine' };
const typeName = (t: string) => TYPES.find(([k]) => k === t)![1].slice(0, -1);
---
<Base title="Card gallery" description="All 55 cards in Myth Mayhem Set v1: creatures, rituals, domains, buildings and patron gods.">
  <section class="wrap gallery">
    <div class="head">
      <h1>Card gallery</h1>
      <p class="lede">All {cards.length} cards in Set v1. Search by name or effect, or filter by type and rarity. Numbers may still be tuned.</p>
    </div>

    <form class="tools" role="search" onsubmit="return false">
      <label class="search">
        <span class="visually-hidden">Search cards</span>
        <input type="search" name="q" placeholder="Search: Aswang, Flight, draw…" autocomplete="off" />
      </label>
      <div class="chips" role="group" aria-label="Card type">
        <button type="button" class="chip" data-type="" aria-pressed="true">All</button>
        {TYPES.map(([k, label]) => <button type="button" class="chip" data-type={k} aria-pressed="false">{label}</button>)}
      </div>
      <div class="chips" role="group" aria-label="Rarity">
        {Object.entries(RARITY).map(([k, label]) => <button type="button" class="chip" data-rarity={k} aria-pressed="false">{label}</button>)}
      </div>
      <label class="sort">
        <span>Sort</span>
        <select name="sort">
          <option value="id">Set order</option>
          <option value="cost">Cost</option>
          <option value="name">Name</option>
        </select>
      </label>
    </form>

    <p class="count" aria-live="polite"><span data-count>{cards.length}</span> cards</p>

    <ul class="grid">
      {cards.map((c, i) => (
        <li data-type={c.type} data-rarity={c.rarity} data-cost={c.cost ?? -1} data-name={c.name} data-order={i}
            data-search={[c.name, c.text, c.alay, c.lore, c.active, c.role, typeName(c.type)].filter(Boolean).join(' ').toLowerCase()}>
          <button type="button" class="tile" data-id={c.id} aria-haspopup="dialog">
            <picture>
              <source srcset={`${c.art}.avif`} type="image/avif" />
              <img src={`${c.art}.webp`} alt="" width="480" height="672" loading={i < 8 ? 'eager' : 'lazy'} />
            </picture>
            <span class="name">{c.name}</span>
            <span class="meta">{typeName(c.type)} · {RARITY[c.rarity]}</span>
          </button>
        </li>
      ))}
    </ul>
    <div class="empty" hidden>
      <p>No cards match your search.</p>
      <button type="button" class="btn btn-line reset">Clear search and filters</button>
    </div>
  </section>

  <dialog class="detail" aria-labelledby="d-name">
    <div class="d-wrap">
      <picture><img class="d-art" src={`${cards[0].art}.webp`} alt="" width="480" height="672" loading="lazy" /></picture>
      <div class="d-info pane">
        <p class="d-meta"></p>
        <h2 id="d-name"></h2>
        <dl class="d-stats"></dl>
        <p class="d-id"></p>
        <form method="dialog"><button class="btn btn-line">Close</button></form>
      </div>
    </div>
  </dialog>

  <script is:inline type="application/json" id="card-data" set:html={JSON.stringify(cards)} />
</Base>

<script>
  import { initGallery } from '../scripts/gallery';
  document.addEventListener('astro:page-load', initGallery);
</script>

<style>
  .gallery { padding-block: var(--s7) var(--chapter); }
  h1 { font-size: clamp(2.5rem, 6vw, 4rem); }
  .head { margin-bottom: var(--s6); }

  .tools { display: grid; gap: var(--s3); margin-bottom: var(--s4); }
  @media (min-width: 1000px) { .tools { grid-template-columns: minmax(260px, 1fr) auto; } .tools .chips:nth-of-type(2) { grid-column: 1; } .sort { grid-column: 2; grid-row: 2; justify-self: end; } }
  input, select { min-height: 44px; border-radius: 4px; border: 1.5px solid var(--paper-soft); background: var(--narra-raised); color: var(--paper); font: 1rem var(--text); padding: 0 var(--s3); }
  input { width: 100%; }
  input::placeholder { color: var(--paper-soft); }
  input:focus-visible, select:focus-visible { border-color: var(--lamp); outline-offset: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s2); }
  .chip { min-height: 40px; }
  .sort { display: flex; align-items: center; gap: var(--s2); color: var(--paper-soft); }
  .count { color: var(--paper-soft); margin: 0 0 var(--s4); font-variant-numeric: tabular-nums; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s5) var(--s4); grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); } }
  .tile { display: grid; gap: var(--s1); width: 100%; padding: 0; border: 0; background: none; color: var(--paper); text-align: left; cursor: pointer; perspective: 800px; }
  .tile img { border-radius: 10px; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .2s var(--ease), box-shadow .2s var(--ease); box-shadow: 0 6px 18px -8px rgb(0 0 0 / .6); }
  .tile:hover img, .tile:focus-visible img { box-shadow: 0 14px 28px -10px rgb(0 0 0 / .7), 0 0 0 2px var(--lamp); }
  .tile:focus-visible { outline: none; }
  .name { font: 400 1.25rem/1.2 var(--display); margin-top: var(--s2); }
  .meta { color: var(--paper-soft); font-size: .875rem; }
  /* a filtered-in card is pulled from the rack: it turns from its edge to its face */
  .grid li.dealt .tile img { animation: deal .32s var(--ease) both; }
  @keyframes deal { from { transform: rotateY(80deg); opacity: .2; } }

  .empty { text-align: center; padding: var(--s8) 0; color: var(--paper-soft); }

  .detail { padding: 0; border: 0; background: transparent; color: inherit; max-width: min(920px, calc(100vw - 2 * var(--gutter))); width: 100%; max-height: calc(100dvh - 32px); }
  .detail::backdrop { background: color-mix(in srgb, var(--muntin) 85%, transparent); }
  .d-wrap { display: grid; gap: var(--muntin-w); background: var(--muntin); padding: var(--muntin-w); }
  @media (min-width: 720px) { .d-wrap { grid-template-columns: 320px 1fr; } }
  .d-art { width: min(320px, 70vw); margin: var(--s4) auto; border-radius: 12px; view-transition-name: none; }
  @media (min-width: 720px) { .d-art { margin: 0; width: 100%; } }
  .d-info { padding: var(--s6); display: grid; align-content: start; gap: var(--s2); }
  .d-meta, .d-id { color: var(--ink-soft); margin: 0; font-size: .9375rem; }
  .d-info h2 { font-size: clamp(2rem, 5vw, 3rem); }
  .d-stats { margin: var(--s3) 0; display: grid; gap: var(--s1) var(--s4); grid-template-columns: max-content 1fr; }
  .d-stats dt { font-weight: 700; }
  .d-stats dd { margin: 0; max-width: 52ch; }
  .d-info form { margin-top: var(--s4); }
</style>
