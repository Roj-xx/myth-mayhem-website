---
const beats = [
  { title: 'The Forgotten World', text: 'The human world and the spirit world once lived side by side. Fear and conflict drove them apart, people forgot, and the aswang, the diwata and the old gods faded into legend.' },
  { title: 'The Awakening', text: 'Something old has stirred. Mythical beings are waking and ancient rivalries are coming back. What woke them, no one knows yet.' },
  { title: 'The two Inheritors', text: 'Only two people can summon these beings: you and one rival. Neither of you knew your heritage. You are not destined enemies; your choices set you against each other.' },
  { title: 'The Relic', text: 'Both of you seek an ancient relic said to move the border between the worlds. What it is, and what it costs, is still unknown.' },
];
---
<section class="world chapter" aria-labelledby="world-title">
  <div class="wrap">
    <div class="head">
      <h2 id="world-title">The Boundary is thinning</h2>
      <p class="lede">You meet your rival where the two worlds touch. Every match is a battle over what happens to both of them.</p>
    </div>

    <ol class="beats lattice">
      {beats.map((b) => (
        <li class="pane beat">
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </li>
      ))}
    </ol>

    <div class="paths">
      <div class="paths-copy">
        <h3>Two paths. Neither is simply right.</h3>
        <p class="soft">Pick a side to see what each Inheritor is fighting for. The path you take changes the story, not the rules.</p>
        <div class="toggle" role="group" aria-label="Choose a path">
          <button class="chip" type="button" aria-pressed="true" data-path="separation">Path of Separation</button>
          <button class="chip" type="button" aria-pressed="false" data-path="control">Path of Control</button>
        </div>
      </div>
      <div class="slider" data-path="separation">
        <div class="panel pane" aria-live="polite">
          <div class="side" data-side="separation">
            <h4>Seal the worlds apart</h4>
            <p>Close the Boundary forever, so humanity is never at the mercy of the spirit world again.</p>
            <p class="cost">The cost: the connection is lost for good.</p>
          </div>
          <div class="side" data-side="control" hidden>
            <h4>Rule both worlds as one</h4>
            <p>Bring both worlds under a single will, so the chaos of the Awakening ends.</p>
            <p class="cost">The cost: freedom, on both sides.</p>
          </div>
        </div>
      </div>
    </div>
    <p class="question">Is peace worth the loss of connection? Can order justify the loss of freedom?</p>
  </div>
</section>

<script>
  function initPaths() {
    const slider = document.querySelector<HTMLElement>('.world .slider');
    if (!slider) return;
    document.querySelectorAll<HTMLButtonElement>('.world .toggle .chip').forEach((btn, _, all) => {
      btn.addEventListener('click', () => {
        const path = btn.dataset.path!;
        all.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        slider.dataset.path = path;
        slider.querySelectorAll<HTMLElement>('.side').forEach((s) => (s.hidden = s.dataset.side !== path));
      });
    });
  }
  document.addEventListener('astro:page-load', initPaths);
</script>

<style>
  .beats { list-style: none; margin: 0; grid-template-columns: 1fr; counter-reset: beat; }
  @media (min-width: 720px) { .beats { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .beats { grid-template-columns: repeat(4, 1fr); } }
  .beat { padding: var(--s6) var(--s5); }
  .beat h3 { font-size: 1.5rem; margin-bottom: var(--s3); }
  .beat p { margin: 0; color: var(--ink-soft); }

  /* scroll-driven: each pane catches the lamp as it enters view */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .beat { animation: lamp linear both; animation-timeline: view(); animation-range: entry 10% cover 45%; }
      @keyframes lamp { from { background-color: var(--capiz-deep); } to { background-color: var(--capiz); } }
    }
  }

  .paths { display: grid; gap: var(--s6); margin-top: var(--s8); align-items: center; }
  @media (min-width: 900px) { .paths { grid-template-columns: 5fr 6fr; gap: var(--s8); } }
  .paths-copy h3 { font-size: clamp(1.75rem, 3vw, 2.25rem); margin-bottom: var(--s3); }
  .soft { color: var(--paper-soft); max-width: 44ch; }
  .toggle { display: flex; flex-wrap: wrap; gap: var(--s2); }
  .toggle .chip { min-height: 44px; }

  /* a sliding window: the new side slides in from the direction you chose */
  .slider { position: relative; overflow: hidden; background: var(--muntin); padding: var(--muntin-w); }
  .panel { min-height: 220px; padding: var(--s6); display: grid; align-content: center; }
  .panel h4 { font: 400 1.75rem/1.2 var(--display); margin: 0 0 var(--s3); }
  .panel p { margin: 0 0 var(--s2); color: var(--ink-soft); max-width: 48ch; }
  .panel .cost { color: var(--ink); font-weight: 700; margin: 0; }
  .side { animation: slide-in .32s var(--ease); }
  .slider[data-path='control'] .side { --from: 24px; }
  @keyframes slide-in { from { opacity: 0; translate: var(--from, -24px) 0; } }

  .question { font: 400 clamp(1.5rem, 3vw, 2rem)/1.3 var(--display); text-align: center; max-width: 30ch; margin: var(--s8) auto 0; text-wrap: balance; }
</style>
