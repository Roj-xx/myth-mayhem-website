---
---
<section id="world" class="world chapter" aria-labelledby="world-title">
  <div class="wrap">
    <div class="head reveal">
      <h2 id="world-title">The Boundary is thinning</h2>
      <p class="lede">The human world and the spirit world were split long ago. Now the old beings are waking, and only two Inheritors can summon them: you, and your rival. Every match is a fight over what happens to both worlds.</p>
    </div>


    <div class="paths glass reveal">
      <div class="paths-copy">
        <h3>Two paths. Neither is simply right.</h3>
        <p class="soft">Pick a side to see what each Inheritor is fighting for. The path you take changes the story, not the rules.</p>
        <div class="toggle" role="group" aria-label="Choose a path">
          <button class="chip" type="button" aria-pressed="true" data-path="separation">Path of Separation</button>
          <button class="chip" type="button" aria-pressed="false" data-path="control">Path of Control</button>
        </div>
      </div>
      <div class="slider" data-path="separation">
        <div class="panel" aria-live="polite">
          <div class="side" data-side="separation">
            <h4>Seal the worlds apart</h4>
            <p>Close the Boundary forever, so humanity is never at the mercy of the spirit world again.</p>
            <p class="cost">The cost: the connection is lost for good.</p>
          </div>
          <div class="side" data-side="control" hidden>
            <h4>Rule both worlds as one</h4>
            <p>Bring both worlds under a single will, so the chaos of the Awakening ends.</p>
            <p class="cost">The cost: freedom, on both sides.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initPaths() {
    const slider = document.querySelector<HTMLElement>('.world .slider');
    if (!slider) return;
    document.querySelectorAll<HTMLButtonElement>('.world .toggle .chip').forEach((btn, _, all) => {
      btn.addEventListener('click', () => {
        const path = btn.dataset.path!;
        all.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        slider.dataset.path = path;
        slider.querySelectorAll<HTMLElement>('.side').forEach((s) => (s.hidden = s.dataset.side !== path));
      });
    });
  }
  document.addEventListener('astro:page-load', initPaths);
</script>

<style>

  .paths { display: grid; gap: var(--s6); align-items: center; padding: var(--s6); }
  @media (min-width: 900px) { .paths { grid-template-columns: 5fr 6fr; gap: var(--s7); padding: var(--s7); } }
  .paths-copy h3 { font-size: clamp(1.75rem, 3vw, 2.375rem); margin-bottom: var(--s3); }
  .soft { color: var(--text-soft); max-width: 44ch; }
  .toggle { display: flex; flex-wrap: wrap; gap: var(--s2); }
  .toggle .chip { min-height: 44px; }

  .slider { border-radius: var(--r); border: 1px solid var(--line); overflow: hidden; position: relative; isolation: isolate; }
  .slider::before, .slider::after { content: ''; position: absolute; inset: 0; z-index: -1; transition: opacity .6s var(--ease); }
  .slider::before { background: radial-gradient(120% 140% at 0% 0%, rgb(194 38 122 / .32), transparent 60%), radial-gradient(120% 140% at 100% 100%, rgb(74 29 134 / .5), transparent 60%); }
  .slider::after { opacity: 0; background: radial-gradient(120% 140% at 100% 0%, rgb(233 196 126 / .24), transparent 60%), radial-gradient(120% 140% at 0% 100%, rgb(74 29 134 / .55), transparent 60%); }
  .slider[data-path='control']::before { opacity: 0; }
  .slider[data-path='control']::after { opacity: 1; }
  .panel { min-height: 220px; padding: var(--s6); display: grid; align-content: center; }
  .panel h4 { font: 400 clamp(1.75rem, 3vw, 2.25rem)/1.15 var(--display); margin: 0 0 var(--s3); }
  .panel p { margin: 0 0 var(--s2); color: var(--text-soft); max-width: 48ch; }
  .panel .cost { color: var(--gold); font-weight: 600; margin: 0; }
  .side { animation: slide-in .45s var(--ease-out); }
  .slider[data-path='control'] .side { --from: 28px; }
  @keyframes slide-in { from { opacity: 0; translate: var(--from, -28px) 0; } }

</style>
