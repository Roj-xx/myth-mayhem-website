---
const modes = [
  { name: 'Tutorial', status: 'Available', text: 'One guided match that teaches you lanes, summon points and Alay as you play. No timer.' },
  { name: 'Vs AI', status: 'Available', text: 'Practise against the computer on Baguhan (Easy), Mandirigma (Normal) or Bagani (Hard).' },
  { name: 'Casual', status: 'Available', text: 'Make a room code and play a friend online. Quick Match against other players is coming soon.' },
  { name: 'Ranked', status: 'Coming soon', text: 'Climb from Baguhan through Mandirigma, Bagani and Datu to Maalamat. Unlocks at level 5.' },
  { name: 'Story', status: 'Coming soon', text: "Play through both Inheritors' paths, Separation and Control." },
];
---
<section class="modes chapter" aria-labelledby="modes-title">
  <div class="wrap">
    <div class="head reveal">
      <h2 id="modes-title">Ways to play</h2>
      <p class="lede">Learn the ropes, practise against the AI, or call out a friend with a room code.</p>
    </div>
    <ul class="list">
      {modes.map((m, i) => (
        <li class:list={['glass glow-card lift reveal', { soon: m.status !== 'Available' }]} style={`--d:${i * 70}ms`}>
          <h3>{m.name}</h3>
          <p class="text">{m.text}</p>
          <p class="status">{m.status}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  li { padding: var(--s6) var(--s5); display: flex; flex-direction: column; gap: var(--s2); border-radius: var(--r); }
  h3 { font-size: 1.875rem; }
  .status { margin: auto 0 0; padding-top: var(--s4); font-size: .8125rem; font-weight: 600; color: var(--gold); display: flex; align-items: center; gap: var(--s2); }
  .status::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; box-shadow: 0 0 10px currentColor; }
  .soon .status { color: var(--text-soft); }
  .soon .status::before { box-shadow: none; }
  .soon h3 { color: var(--text-soft); }
  .text { margin: 0; color: var(--text-soft); font-size: .9375rem; }
</style>
