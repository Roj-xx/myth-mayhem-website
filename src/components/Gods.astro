---
import cards from '../data/cards.json';
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const gods = cards.filter((c) => c.type === 'god');
---
<section id="gods" class="gods chapter" aria-labelledby="gods-title">
  <div class="wrap">
    <div class="head reveal">
      <h2 id="gods-title">Pick a patron god</h2>
      <p class="lede">Your god never fights on the board. It watches from above with a Passive that is always on, and an Active you charge up over three turns. Three are yours from the start; the rest come from the Tawag.</p>
    </div>

    <div class="picker reveal">
      <div class="tabs glass" role="tablist" aria-label="Patron gods">
        {gods.map((g, i) => (
          <button role="tab" id={`tab-${g.id}`} aria-controls={`panel-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} type="button">
            <picture>
              <source srcset={`/media/avatars/${slug(g.name)}-160.avif`} type="image/avif" />
              <img src={`/media/avatars/${slug(g.name)}-160.webp`} alt="" width="160" height="160" loading="lazy" />
            </picture>
            <span>{g.name}</span>
          </button>
        ))}
      </div>

      {gods.map((g, i) => (
        <div class="panel glass glow-card" role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`} hidden={i !== 0}>
          <picture class="portrait">
            <source srcset={`/media/avatars/${slug(g.name)}.avif`} type="image/avif" />
            <img src={`/media/avatars/${slug(g.name)}.webp`} alt={`${g.name}, patron god`} width="640" height="640" loading="lazy" />
          </picture>
          <div class="info">
            <h3>{g.name}</h3>
            <p class="role">{g.role} · {g.access === 'Starter' ? 'Starter god' : 'From the Tawag or crafted'}</p>
            <dl>
              <dt>Passive</dt><dd>{g.passive}</dd>
              <dt>Active <span>(3 Charges)</span></dt><dd>{g.active}</dd>
            </dl>
            <p class="lore">{g.lore}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initGods() {
    const list = document.querySelector<HTMLElement>('.gods [role=tablist]');
    if (!list) return;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        const jump = e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : null;
        if (step == null && jump == null) return;
        e.preventDefault();
        select(tabs[jump ?? (i + step! + tabs.length) % tabs.length], true);
      });
    });
  }
  document.addEventListener('astro:page-load', initGods);
</script>

<style>
  .picker { display: grid; gap: var(--s5); }
  @media (min-width: 960px) { .picker { grid-template-columns: 5fr 7fr; align-items: stretch; } }

  .tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s2); padding: var(--s4); align-content: start; }
  @media (min-width: 600px) and (max-width: 959px) { .tabs { grid-template-columns: repeat(6, 1fr); } }
  @media (max-width: 380px) { .tabs { grid-template-columns: repeat(3, 1fr); padding: var(--s3); } [role=tab] img { width: 56px; height: 56px; } .panel { padding: var(--s5); } }
  .picker > * { min-width: 0; }
  [role=tab] { display: grid; justify-items: center; gap: var(--s2); padding: var(--s3) var(--s1); border: 0; border-radius: var(--r-sm); background: none; cursor: pointer; color: var(--text-soft); font: 500 .8125rem/1.2 var(--text-font); transition: background-color .3s var(--ease), color .3s var(--ease); }
  [role=tab] img { width: 64px; height: 64px; border-radius: 50%; filter: saturate(.6) brightness(.85); box-shadow: 0 0 0 1px var(--line); transition: filter .35s var(--ease), transform .45s var(--ease-out), box-shadow .35s var(--ease); }
  [role=tab]:hover { color: var(--text); background: rgb(255 255 255 / .04); }
  [role=tab]:hover img { filter: none; transform: translateY(-3px) scale(1.06); }
  [role=tab][aria-selected=true] { color: var(--text); background: rgb(233 196 126 / .1); }
  [role=tab][aria-selected=true] img { filter: none; transform: scale(1.1); box-shadow: 0 0 0 2px var(--gold), 0 0 26px rgb(233 196 126 / .55); }

  .panel { display: grid; gap: var(--s6); grid-template-columns: minmax(0, 1fr); padding: var(--s6); align-items: center; animation: show .55s var(--ease-out); }
  @media (min-width: 640px) { .panel { grid-template-columns: 240px 1fr; padding: var(--s7); } }
  @keyframes show { from { opacity: 0; transform: translateY(12px) scale(.98); } }
  /* a halo turns slowly behind the god */
  .portrait { position: relative; display: block; width: min(240px, 64vw); justify-self: center; }
  .portrait::before { content: ''; position: absolute; inset: -14%; border-radius: 50%; z-index: -1;
    background: conic-gradient(from 0deg, transparent, rgb(233 196 126 / .55), transparent 30%, rgb(240 139 192 / .5), transparent 60%, rgb(233 196 126 / .4), transparent);
    filter: blur(14px); will-change: rotate; animation: halo 14s linear infinite; }
  :global(.lite) .portrait::before { animation: none; }
  @keyframes halo { to { rotate: 360deg; } }
  .portrait img { width: 100%; border-radius: 50%; }
  .info h3 { font-size: clamp(2.25rem, 4vw, 3rem); }
  .role { color: var(--gold); margin: var(--s1) 0 var(--s5); font-weight: 600; font-size: .9375rem; }
  dl { margin: 0 0 var(--s5); display: grid; gap: var(--s3); }
  dl > dt { font-family: var(--display); font-size: 1.25rem; color: var(--text); }
  dt span { font-family: var(--text-font); font-size: .875rem; color: var(--text-soft); }
  dd { margin: 0 0 var(--s2); color: var(--text-soft); max-width: 48ch; }
  .lore { color: var(--text-soft); opacity: .8; font-size: .875rem; font-style: italic; max-width: 52ch; margin: 0; }
</style>
