---
const path = Astro.url.pathname;
const links = [
  { href: '/#match', label: 'How to play' },
  { href: '/#collect', label: 'Collect' },
  { href: '/cards', label: 'Cards' },
  { href: '/docs', label: 'Docs' },
];
---
<header class="nav">
  <div class="bar glass">
    <a href="/" class="logo" aria-label="Myth Mayhem home">
      <picture>
        <source srcset="/media/logo.avif" type="image/avif" />
        <img src="/media/logo.webp" alt="" width="900" height="300" />
      </picture>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li class:list={{ extra: l.href.startsWith('/#'), 'cards-link': l.href === '/cards' }}><a href={l.href} aria-current={!l.href.startsWith('/#') && path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><a class="btn btn-primary magnetic" href="/#download">Download</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // the bar tightens once you scroll
  function initNav() {
    const nav = document.querySelector('.nav');
    if (!nav) return;
    const set = () => document.querySelector(".nav")?.classList.toggle("scrolled", scrollY > 24);
    set();
    if (!(window as any).__navBound) { (window as any).__navBound = true; addEventListener("scroll", set, { passive: true }); }
  }
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 50; padding: var(--s3) var(--gutter) 0; transition: padding .4s var(--ease-out); }
  .bar { max-width: var(--max); margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: var(--s4); min-height: 64px; padding: 0 var(--s2) 0 var(--s5); border-radius: 999px; background: rgb(21 10 38 / .5); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); transition: background-color .4s var(--ease), box-shadow .4s var(--ease); }
  :global(.lite) .bar { backdrop-filter: none; -webkit-backdrop-filter: none; background: rgb(21 10 38 / .92); }
  .nav.scrolled .bar { background: rgb(21 10 38 / .75); box-shadow: 0 20px 50px -25px rgb(0 0 0 / .8), inset 0 1px 0 rgb(255 255 255 / .1); }
  .logo { flex: none; }
  .logo img { width: 128px; height: auto; transition: transform .4s var(--ease-out); }
  .logo:hover img { transform: scale(1.04); }
  ul { display: flex; align-items: center; gap: var(--s1); list-style: none; margin: 0; padding: 0; }
  li a:not(.btn) { position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--s3); text-decoration: none; color: var(--text-soft); font-weight: 500; transition: color .25s var(--ease); }
  li a:not(.btn)::after { content: ''; position: absolute; left: var(--s3); right: var(--s3); bottom: 10px; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); transform: scaleX(0); transition: transform .35s var(--ease-out); }
  li a:not(.btn):hover, li a[aria-current='page'] { color: var(--text); }
  li a:not(.btn):hover::after, li a[aria-current='page']::after { transform: scaleX(1); }
  .btn { min-height: 46px; padding: 0 var(--s5); margin-left: var(--s2); }
  @media (max-width: 640px) { .extra { display: none; } .bar { padding-left: var(--s4); gap: var(--s2); } .logo img { width: 96px; } .btn { padding: 0 14px; min-height: 42px; margin-left: var(--s1); } li a:not(.btn) { padding: 0 6px; } }
  @media (max-width: 380px) { .cards-link { display: none; } }
</style>
