---
import { site } from '../config/site';
// Captured from the v0.3.0 Windows build (Vs AI). Account names are blurred.
const shots = [
  { id: 'board', caption: 'The battlefield, three lanes a side' },
  { id: 'prematch', caption: 'Pick a deck, a patron god and a difficulty' },
  { id: 'coin', caption: 'Kara y Krus decides who goes first' },
  { id: 'hand', caption: 'Your starting hand: swap one card, once' },
  { id: 'detail', caption: 'Every card explains itself' },
  { id: 'menu', caption: 'Main menu' },
];
---
<section id="gameplay" class="screens chapter" aria-labelledby="screens-title">
  <div class="wrap">
    <div class="head reveal">
      <h2 id="screens-title">Inside the game</h2>
      <p class="lede">Captured straight from the Windows build of v{site.version}. Tap any shot to see it full size.</p>
    </div>

    <div class="bento">
      {shots.map((s, i) => (
        <button type="button" class:list={['shot glass glow-card reveal', { big: i === 0 }]} style={`--d:${(i % 3) * 80}ms`} data-full={`/media/shots/${s.id}-1600`} data-caption={s.caption}>
          <picture>
            <source srcset={`/media/shots/${s.id}-800.avif 800w, /media/shots/${s.id}-1600.avif 1600w`} sizes="(min-width: 900px) 33vw, 100vw" type="image/avif" />
            <img src={`/media/shots/${s.id}-800.webp`} srcset={`/media/shots/${s.id}-800.webp 800w, /media/shots/${s.id}-1600.webp 1600w`} sizes="(min-width: 900px) 33vw, 100vw" alt={s.caption} width="800" height="450" loading="lazy" />
          </picture>
          <span class="cap">{s.caption}</span>
        </button>
      ))}
    </div>
  </div>

  <dialog class="lightbox" aria-label="Screenshot">
    <form method="dialog"><button class="close btn btn-glass" aria-label="Close">Close</button></form>
    <img src="/media/shots/menu-1600.webp" alt="" width="1600" height="900" />
    <p></p>
  </dialog>
</section>

<script>
  function initScreens() {
    const root = document.querySelector('.screens');
    if (!root) return;
    const dlg = root.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector('p')!;
    let opener: HTMLElement | null = null;
    root.querySelectorAll<HTMLButtonElement>('.shot').forEach((b) => b.addEventListener('click', () => {
      opener = b;
      img.src = `${b.dataset.full}.webp`;
      img.alt = b.dataset.caption!;
      cap.textContent = b.dataset.caption!;
      dlg.showModal();
    }));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => opener?.focus());
  }
  document.addEventListener('astro:page-load', initScreens);
</script>

<style>
  .bento { display: grid; gap: var(--s4); grid-template-columns: 1fr; }
  @media (min-width: 700px) { .bento { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .bento { grid-template-columns: repeat(3, 1fr); } .big { grid-column: span 2; grid-row: span 2; } }
  .shot { margin: 0; padding: var(--s2); border-radius: var(--r); }
  .cap { display: block; padding: var(--s3) var(--s2) var(--s1); font-size: .875rem; color: var(--text-soft); text-align: left; }
  .shot { border: 1px solid var(--line); cursor: zoom-in; color: inherit; font: inherit; display: block; width: 100%; }
  .shot picture { display: block; overflow: hidden; border-radius: calc(var(--r) - 8px); }
  .big picture, .big img { height: calc(100% - 40px); }
  .shot img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform .9s var(--ease-out), filter .5s var(--ease); filter: saturate(.92); }
  .shot:hover img { transform: scale(1.06); filter: saturate(1.1); }

  .lightbox { padding: 0; border: 0; background: transparent; color: var(--text); max-width: min(1200px, calc(100vw - 2 * var(--gutter))); width: 100%; overflow: visible; }
  .lightbox::backdrop { background: rgb(11 6 20 / .8); backdrop-filter: blur(10px); }
  .lightbox[open] { animation: zoom .4s var(--ease-out); }
  @keyframes zoom { from { opacity: 0; transform: scale(.96); } }
  .lightbox img { width: 100%; border-radius: var(--r); box-shadow: 0 40px 100px -20px rgb(0 0 0 / .8); }
  .lightbox p { text-align: center; color: var(--text-soft); margin: var(--s3) 0 0; }
  .close { position: absolute; top: -60px; right: 0; min-height: 44px; }
</style>
